---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { siteMeta } from '../../data/site';
import { blogTags, getPostUrl, getSeriesName, getTagMeta, getTagSlug } from '../../utils/blog';
import { formatDate } from '../../utils/format';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
  );

  const tagSlugs = Array.from(
    new Set(posts.flatMap((post) => post.data.tags.map((tag) => getTagSlug(tag))))
  );

  return tagSlugs.map((slug) => ({
    params: { slug },
    props: {
      tag: getTagMeta(slug),
      posts: posts.filter((post) => post.data.tags.some((tag) => getTagSlug(tag) === slug))
    }
  }));
}

interface Props {
  tag: (typeof blogTags)[number];
  posts: CollectionEntry<'blog'>[];
}

const { tag, posts } = Astro.props;
const tagUrl = new URL(`${siteMeta.rootPath}tags/${tag.slug}/`, siteMeta.siteUrl).toString();
const description = `${tag.ko} 태그가 붙은 블로그 글을 모아둔 페이지입니다.`;
const tagStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: tag.ko,
  description,
  url: tagUrl,
  hasPart: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: new URL(`${siteMeta.rootPath}${post.data.number}/`, siteMeta.siteUrl).toString(),
    datePublished: post.data.publishedAt.toISOString()
  }))
};
---

<BaseLayout title={tag.ko} description={description} structuredData={tagStructuredData}>
  <div class="blog-tag-detail-page">
    <section class="blog-tag-detail-header">
      <p class="eyebrow" data-i18n-ko="태그" data-i18n-en="Tag">태그</p>
      <div class="blog-tag-detail-title-row">
        <h1 class="blog-tag-detail-title" data-i18n-ko={tag.ko} data-i18n-en={tag.en}>{tag.ko}</h1>
        <p
          class="blog-tag-detail-count"
          data-i18n-ko={`${posts.length}개 글`}
          data-i18n-en={`${posts.length} posts`}
        >
          {posts.length}개 글
        </p>
      </div>
    </section>

    <div class="blog-list-header blog-tag-detail-tools">
      <div class="blog-list-tools">
        <p class="type-small text-ink/58">
          <span data-visible-count>{posts.length}</span> / {posts.length}
        </p>
        <div class="blog-sort-toggle" aria-label="태그 글 정렬">
          <button
            type="button"
            class="blog-sort-button blog-sort-button-active"
            data-sort-button
            data-sort-value="desc"
            aria-pressed="true"
          >
            <span data-i18n-ko="최신순" data-i18n-en="Newest">최신순</span>
          </button>
          <span class="blog-sort-separator" aria-hidden="true">|</span>
          <button type="button" class="blog-sort-button" data-sort-button data-sort-value="asc" aria-pressed="false">
            <span data-i18n-ko="오래된순" data-i18n-en="Oldest">오래된순</span>
          </button>
        </div>
      </div>
    </div>

    <div class="blog-post-list blog-post-list-list blog-post-list-after-series" data-tag-list>
      {
        posts.map((post) => (
          <div data-tag-item data-date={post.data.publishedAt.valueOf()}>
            <ContentCard
              href={getPostUrl(post)}
              title={post.data.title}
              description={post.data.excerpt}
              meta={getSeriesName(post.data.series)}
              date={formatDate(post.data.publishedAt)}
              tags={post.data.tags}
              cover={post.data.cover}
            />
          </div>
        ))
      }
    </div>

    <nav class="blog-pagination" aria-label="태그 글 페이지" data-tag-pagination hidden></nav>
  </div>

  <script is:inline>
    (() => {
      const list = document.querySelector('[data-tag-list]');
      const items = Array.from(document.querySelectorAll('[data-tag-item]'));
      const sortButtons = Array.from(document.querySelectorAll('[data-sort-button]'));
      const visibleCountLabel = document.querySelector('[data-visible-count]');
      const pagination = document.querySelector('[data-tag-pagination]');
      const pageSize = 10;
      let activeSort = 'desc';
      let activePage = 1;

      const getSortedItems = () =>
        [...items].sort((a, b) => {
          const aDate = Number(a.getAttribute('data-date') || 0);
          const bDate = Number(b.getAttribute('data-date') || 0);
          return activeSort === 'asc' ? aDate - bDate : bDate - aDate;
        });

      const createPaginationButton = (label, page, disabled = false, current = false, ariaLabel = `${page}페이지로 이동`) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'blog-pagination-button';
        button.textContent = label;
        button.disabled = disabled;
        button.setAttribute('aria-label', ariaLabel);
        if (current) {
          button.classList.add('blog-pagination-button-active');
          button.setAttribute('aria-current', 'page');
        }
        button.addEventListener('click', () => {
          activePage = page;
          apply();
        });
        return button;
      };

      const renderPagination = (totalPages) => {
        if (!(pagination instanceof HTMLElement)) return;
        pagination.replaceChildren();
        pagination.hidden = totalPages <= 1;
        if (totalPages <= 1) return;

        pagination.appendChild(createPaginationButton('«', 1, activePage === 1, false, '첫 페이지로 이동'));
        pagination.appendChild(
          createPaginationButton('‹', Math.max(1, activePage - 1), activePage === 1, false, '이전 페이지로 이동')
        );

        for (let page = 1; page <= totalPages; page += 1) {
          pagination.appendChild(createPaginationButton(String(page), page, false, page === activePage));
        }

        pagination.appendChild(
          createPaginationButton(
            '›',
            Math.min(totalPages, activePage + 1),
            activePage === totalPages,
            false,
            '다음 페이지로 이동'
          )
        );
        pagination.appendChild(createPaginationButton('»', totalPages, activePage === totalPages, false, '마지막 페이지로 이동'));
      };

      const applySort = () => {
        if (!(list instanceof HTMLElement)) return;

        getSortedItems().forEach((item) => list.appendChild(item));
        sortButtons.forEach((button) => {
          const isActive = button.getAttribute('data-sort-value') === activeSort;
          button.classList.toggle('blog-sort-button-active', isActive);
          button.setAttribute('aria-pressed', String(isActive));
        });
      };

      const apply = () => {
        const sortedItems = getSortedItems();
        const totalPages = Math.max(1, Math.ceil(sortedItems.length / pageSize));
        activePage = Math.min(activePage, totalPages);
        const pageStart = (activePage - 1) * pageSize;
        const pageItems = new Set(sortedItems.slice(pageStart, pageStart + pageSize));

        items.forEach((item) => {
          item.toggleAttribute('hidden', !pageItems.has(item));
        });

        if (visibleCountLabel instanceof HTMLElement) {
          visibleCountLabel.textContent = String(sortedItems.length);
        }

        renderPagination(totalPages);
      };

      sortButtons.forEach((button) => {
        button.addEventListener('click', () => {
          activeSort = button.getAttribute('data-sort-value') || 'desc';
          activePage = 1;
          applySort();
          apply();
        });
      });

      applySort();
      apply();
    })();
  </script>
</BaseLayout>
