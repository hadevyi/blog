---
import { getCollection } from 'astro:content';
import ContentCard from '../components/ContentCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostUrl, getSeriesName } from '../utils/blog';
import { formatDate } from '../utils/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);

---

<BaseLayout>
  <div class="space-y-6" data-archive-root="blog">
    <section id="posts" class="space-y-4">
      <div class="blog-list-header">
        <span class="sr-only">글 목록</span>
        <div class="blog-list-tools">
          <p class="type-small text-ink/58">
            <span data-visible-count>{posts.length}</span> / {posts.length}
          </p>
          <div class="blog-sort-toggle" aria-label="글 정렬">
            <button
              type="button"
              class="blog-sort-button blog-sort-button-active"
              data-sort-button
              data-sort-value="desc"
              aria-pressed="true"
            >
              <span data-i18n-ko="최신순" data-i18n-en="Newest">최신순</span>
            </button>
            <span class="blog-sort-separator" aria-hidden="true">|</span>
            <button type="button" class="blog-sort-button" data-sort-button data-sort-value="asc" aria-pressed="false">
              <span data-i18n-ko="오래된순" data-i18n-en="Oldest">오래된순</span>
            </button>
          </div>
        </div>
      </div>
      <div class="blog-post-list blog-post-list-list" data-archive-list>
        {
          posts.map((post) => (
            <div
              data-archive-item
              data-search={`${post.data.title} ${post.data.excerpt} ${getSeriesName(post.data.series)} ${post.data.category} ${post.data.tags.join(' ')}`.toLowerCase()}
              data-series={post.data.series}
              data-category={post.data.category}
              data-tags={post.data.tags.join('|')}
              data-date={post.data.publishedAt.valueOf()}
            >
              <ContentCard
                href={getPostUrl(post)}
                title={post.data.title}
                description={post.data.excerpt}
                meta={getSeriesName(post.data.series)}
                date={formatDate(post.data.publishedAt)}
                tags={post.data.tags}
                cover={post.data.cover}
              />
            </div>
          ))
        }
      </div>

      <p class="type-small text-ink/58" data-archive-empty hidden>
        <span data-i18n-ko="현재 조건에 맞는 글이 없습니다." data-i18n-en="No posts match the current condition.">
          현재 조건에 맞는 글이 없습니다.
        </span>
      </p>

      <nav class="blog-pagination" aria-label="글 목록 페이지" data-pagination hidden></nav>
    </section>
  </div>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-archive-root="blog"]');
      if (!root) return;

      const searchInputs = Array.from(document.querySelectorAll('[data-blog-search]')).filter(
        (input) => input instanceof HTMLInputElement
      );
      const items = Array.from(document.querySelectorAll('[data-archive-item]'));
      const sortButtons = Array.from(document.querySelectorAll('[data-sort-button]'));
      const empty = document.querySelector('[data-archive-empty]');
      const visibleCountLabel = document.querySelector('[data-visible-count]');
      const pagination = document.querySelector('[data-pagination]');
      const pageSize = 10;
      let activeSort = 'desc';
      let activePage = 1;

      const syncSearchInputs = (value) => {
        searchInputs.forEach((input) => {
          if (input.value !== value) input.value = value;
        });
      };

      const getSortedItems = () =>
        [...items].sort((a, b) => {
          const aDate = Number(a.getAttribute('data-date') || 0);
          const bDate = Number(b.getAttribute('data-date') || 0);
          return activeSort === 'asc' ? aDate - bDate : bDate - aDate;
        });

      const getFilteredItems = () => {
        const query = searchInputs[0]?.value.trim().toLowerCase() || '';
        return getSortedItems().filter((item) => {
          const searchValue = (item.getAttribute('data-search') || '').toLowerCase();
          return !query || searchValue.includes(query);
        });
      };

      const createPaginationButton = (label, page, disabled = false, current = false, ariaLabel = `${page}페이지로 이동`) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'blog-pagination-button';
        button.textContent = label;
        button.disabled = disabled;
        button.setAttribute('aria-label', ariaLabel);
        if (current) {
          button.classList.add('blog-pagination-button-active');
          button.setAttribute('aria-current', 'page');
        }
        button.addEventListener('click', () => {
          activePage = page;
          apply();
        });
        return button;
      };

      const renderPagination = (totalPages) => {
        if (!(pagination instanceof HTMLElement)) return;
        pagination.replaceChildren();
        pagination.hidden = totalPages <= 1;
        if (totalPages <= 1) return;

        pagination.appendChild(createPaginationButton('«', 1, activePage === 1, false, '첫 페이지로 이동'));
        pagination.appendChild(
          createPaginationButton('‹', Math.max(1, activePage - 1), activePage === 1, false, '이전 페이지로 이동')
        );

        for (let page = 1; page <= totalPages; page += 1) {
          pagination.appendChild(createPaginationButton(String(page), page, false, page === activePage));
        }

        pagination.appendChild(
          createPaginationButton(
            '›',
            Math.min(totalPages, activePage + 1),
            activePage === totalPages,
            false,
            '다음 페이지로 이동'
          )
        );
        pagination.appendChild(createPaginationButton('»', totalPages, activePage === totalPages, false, '마지막 페이지로 이동'));
      };

      const apply = () => {
        const filteredItems = getFilteredItems();
        const visibleCount = filteredItems.length;
        const totalPages = Math.max(1, Math.ceil(visibleCount / pageSize));
        activePage = Math.min(activePage, totalPages);
        const pageStart = (activePage - 1) * pageSize;
        const pageEnd = pageStart + pageSize;
        const pageItems = new Set(filteredItems.slice(pageStart, pageEnd));

        items.forEach((item) => {
          item.toggleAttribute('hidden', !pageItems.has(item));
        });

        if (empty instanceof HTMLElement) {
          empty.hidden = visibleCount !== 0;
        }

        if (visibleCountLabel instanceof HTMLElement) {
          visibleCountLabel.textContent = String(visibleCount);
        }

        renderPagination(totalPages);
      };

      const applySort = () => {
        const list = document.querySelector('[data-archive-list]');
        if (!(list instanceof HTMLElement)) return;

        getSortedItems().forEach((item) => list.appendChild(item));
        sortButtons.forEach((button) => {
          const isActive = button.getAttribute('data-sort-value') === activeSort;
          button.classList.toggle('blog-sort-button-active', isActive);
          button.setAttribute('aria-pressed', String(isActive));
        });
      };

      const initialQuery = new URLSearchParams(window.location.search).get('q') || '';
      syncSearchInputs(initialQuery);

      searchInputs.forEach((input) => {
        input.addEventListener('input', () => {
          syncSearchInputs(input.value);
          activePage = 1;
          apply();
        });
      });

      sortButtons.forEach((button) => {
        button.addEventListener('click', () => {
          activeSort = button.getAttribute('data-sort-value') || 'desc';
          activePage = 1;
          applySort();
          apply();
        });
      });

      applySort();
      apply();
    })();
  </script>
</BaseLayout>
